{
  "mcpServers": {
    "bugsink": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "envmcp",
        "--env-file",
        "ai/.env",
        "npx",
        "-y",
        "bugsink-mcp"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics"
      ]
    },
    "sync_todo": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "envmcp",
        "--env-file",
        "ai/.env",
        "npx",
        "-y",
        "mcp-remote",
        "http://localhost:8000/mcp",
        "--header",
        "Authorization:${SYNC_TODO_MCP_TOKEN}"
      ]
    }
  }
}
