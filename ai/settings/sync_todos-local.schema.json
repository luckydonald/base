{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckydonald/base/ai/settings/sync_todos-local.schema.json",
  "title": "Machine-local todo sync settings (project paths)",
  "$defs": {
    "LocalProject": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project root on this machine. `~` is expanded, relative paths are relative to the git root. null: the project is skipped, nothing is read or written there.",
          "title": "Path"
        },
        "commit_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the tracked per-project and global commit prefix; null keeps them.",
          "title": "Commit Prefix"
        }
      },
      "title": "LocalProject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "projects": {
      "additionalProperties": {
        "$ref": "#/$defs/LocalProject"
      },
      "description": "Project name (as in the tracked mapping) to its machine-local settings.",
      "title": "Projects",
      "type": "object"
    }
  },
  "type": "object"
}
